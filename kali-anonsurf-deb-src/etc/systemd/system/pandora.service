[Unit]
Description=Pandora module - shutdown ram cleaner
After=umountroot.target
Before=shutdown.target reboot.target halt.target
DefaultDependencies=no

[Service]
Type=oneshot
RemainAfterExit=true
# sdmem needs minutes on a large-RAM host. With the default 90s systemd
# SIGTERMs the wipe halfway through and the RAM is not cleared.
TimeoutStopSec=0
ExecStart=/bin/true
ExecStop=/etc/init.d/pandora stop

[Install]
WantedBy=shutdown.target
