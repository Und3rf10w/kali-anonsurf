#!/bin/bash

### BEGIN INIT INFO
# Provides:          anonsurf
# Required-Start:
# Required-Stop:
# Should-Start:
# Default-Start:
# Default-Stop:
# Short-Description: Transparent Proxy through TOR.
### END INIT INFO

# AnonSurf is inspired by the homonimous module of PenMode, developed by the "Pirates' Crew" in
# order to make it fully compatible with
# Parrot  OS and other debian-based systems, and it is part of
# parrot-anon package.
#
#
# Devs:
# Lorenzo 'EclipseSpark' Faletra <eclipse@frozenbox.org>
# Lisetta 'Sheireen' Ferrero <sheireen@frozenbox.org>
# Francesco 'mibofra'/'Eli Aran'/'SimpleSmibs' Bonanno <mibofra@ircforce.tk> <mibofra@frozenbox.org>
#
#
# anonsurf is free software: you can redistribute it and/or
# modify it under the terms of the GNU General Public License as
# published by the Free Software Foundation, either version 3 of the
# License, or (at your option) any later version.
# You can get a copy of the license at www.gnu.org/licenses
#
# anonsurf is distributed in the hope that it will be
# useful, but WITHOUT ANY WARRANTY; without even the implied warranty of
# MERCHANTABILITY or FITNESS FOR A PARTICULAR PURPOSE. See the GNU
# General Public License for more details.
#
# You should have received a copy of the GNU General Public License
# along with Parrot Security OS. If not, see <http://www.gnu.org/licenses/>.
#
# Changes by this fork:
#   * every rule lives in the anonsurf owned chains ANONSURF_NAT / ANONSURF_OUT,
#     so UFW, Docker, VPN and libvirt state is never flushed;
#   * UDP is no longer redirected to the Tor TransPort, which cannot carry it,
#     and DHCP is explicitly kept off the redirect;
#   * DNS is configured through systemd-resolved, resolvconf or /etc/resolv.conf
#     depending on what the host actually uses, and the previous state is restored;
#   * "change" signals NEWNYM over the Tor control socket instead of sending SIGHUP;
#   * IPv6 is re-enabled again on stop, and pre-existing connections are dropped.

# ---------------------------------------------------------------------------
# configuration (override in /etc/default/anonsurf)
# ---------------------------------------------------------------------------
[ -r /etc/default/anonsurf ] && . /etc/default/anonsurf

export BLUE='\033[1;94m'
export GREEN='\033[1;92m'
export RED='\033[1;91m'
export YELLOW='\033[1;93m'
export RESETCOLOR='\033[1;00m'

# The UID Tor runs as. Change it if `ps -eo user,comm | grep tor` shows another user.
TOR_UID="${TOR_UID:-debian-tor}"
# Tor's TransPort, DNSPort and SocksPort.
TOR_TRANS_PORT="${TOR_TRANS_PORT:-9040}"
TOR_DNS_PORT="${TOR_DNS_PORT:-53}"
TOR_SOCKS_PORT="${TOR_SOCKS_PORT:-9050}"
# Tor control socket and cookie, provided by the distribution package.
TOR_CONTROL_SOCKET="${TOR_CONTROL_SOCKET:-/run/tor/control}"
TOR_CONTROL_COOKIE="${TOR_CONTROL_COOKIE:-/run/tor/control.authcookie}"
# systemd unit started and queried by this script.
TOR_UNIT="${TOR_UNIT:-tor@default.service}"

# Chains owned by anonsurf. Nothing outside these chains is modified.
NAT_CHAIN="ANONSURF_NAT"
OUT_CHAIN="ANONSURF_OUT"

# Destinations you don't want routed through Tor.
TOR_EXCLUDE="${TOR_EXCLUDE:-192.168.0.0/16 172.16.0.0/12 10.0.0.0/8}"
LOOPBACK="127.0.0.0/8"
MULTICAST="224.0.0.0/4"
LIMITED_BROADCAST="255.255.255.255/32"
# Tor maps .onion names into this range.
VIRTUAL_ADDR_NET="${VIRTUAL_ADDR_NET:-10.192.0.0/10}"

SYSCTL_CONF="/etc/sysctl.d/98-kali-anonsurf.conf"
RESOLVED_DROPIN="/etc/systemd/resolved.conf.d/90-anonsurf.conf"
RESOLVCONF_HEAD="/etc/resolvconf/resolv.conf.d/head"
RESOLVCONF_HEAD_BAK="${RESOLVCONF_HEAD}.anonsurf.bak"
RESOLV_CONF="/etc/resolv.conf"
RESOLV_CONF_BAK="${RESOLV_CONF}.anonsurf.bak"

# Set to 0 to leave applications and caches alone when the tunnel is toggled.
ANONSURF_KILL_APPS="${ANONSURF_KILL_APPS:-1}"
# Set to 0 to keep pre-existing connections alive on start (they will bypass Tor).
ANONSURF_FLUSH_CONNTRACK="${ANONSURF_FLUSH_CONNTRACK:-1}"

DANGEROUS_APPS="chrome chromium firefox iceweasel icedove thunderbird dropbox skype
xchat transmission deluge pidgin telegram-desktop"

# ---------------------------------------------------------------------------
# output helpers
# ---------------------------------------------------------------------------
info()  { echo -e " $GREEN*$BLUE $*$RESETCOLOR"; }
warn()  { echo -e " $YELLOW!$BLUE $*$RESETCOLOR" >&2; }
error() { echo -e " $RED!$BLUE $*$RESETCOLOR" >&2; }
step()  { echo -e "\n$GREEN[$BLUE i$GREEN ]$BLUE $*$RESETCOLOR"; }

require_root() {
	if [ "$(id -u)" -ne 0 ]; then
		error "This script must be run as root"
		exit 1
	fi
}

# ---------------------------------------------------------------------------
# Tor
# ---------------------------------------------------------------------------
tor_uid_ok() {
	id -u "$TOR_UID" >/dev/null 2>&1
}

# Fail before touching the firewall: an unresolvable TOR_UID would leave the
# host rejected by its own OUTPUT chain with no exception for Tor itself.
require_tor_uid() {
	if ! tor_uid_ok; then
		error "Tor user '$TOR_UID' does not exist."
		error "Install the tor package or set TOR_UID in /etc/default/anonsurf."
		return 1
	fi
	return 0
}

tor_running() {
	if command -v systemctl >/dev/null 2>&1; then
		systemctl is-active --quiet "$TOR_UNIT"
	else
		[ -e /var/run/tor/tor.pid ]
	fi
}

tor_start() {
	if tor_running; then
		return 0
	fi
	info "Tor is not running, starting $TOR_UNIT"
	if command -v systemctl >/dev/null 2>&1; then
		systemctl start "$TOR_UNIT" >/dev/null 2>&1
	fi
	local i
	for i in $(seq 1 30); do
		tor_running && return 0
		sleep 1
	done
	error "Tor did not come up within 30 seconds; run 'journalctl -u $TOR_UNIT'"
	return 1
}

tor_stop() {
	if command -v systemctl >/dev/null 2>&1; then
		systemctl stop "$TOR_UNIT" >/dev/null 2>&1
	else
		[ -e /var/run/tor/tor.pid ] && kill "$(cat /var/run/tor/tor.pid)" 2>/dev/null
	fi
	return 0
}

# NEWNYM asks Tor for fresh circuits. SIGHUP does not: it only re-reads the
# configuration, and Tor keeps reusing circuits for up to MaxCircuitDirtiness.
tor_newnym() {
	local cookie
	if [ ! -S "$TOR_CONTROL_SOCKET" ]; then
		error "Tor control socket $TOR_CONTROL_SOCKET not found."
		error "Set ControlSocket or ControlPort in the Tor configuration."
		return 1
	fi
	if ! command -v socat >/dev/null 2>&1; then
		error "socat is required to signal NEWNYM; install the socat package."
		return 1
	fi
	if [ ! -r "$TOR_CONTROL_COOKIE" ]; then
		error "Tor cookie $TOR_CONTROL_COOKIE is not readable; run as root."
		return 1
	fi
	cookie=$(od -An -tx1 -v "$TOR_CONTROL_COOKIE" | tr -d ' \n')
	printf 'AUTHENTICATE "%s"\r\nSIGNAL NEWNYM\r\nQUIT\r\n' "$cookie" \
		| socat -t 5 - "UNIX-CONNECT:$TOR_CONTROL_SOCKET" >/dev/null 2>&1
	local rc=$?
	unset cookie
	if [ $rc -ne 0 ]; then
		error "Failed to signal NEWNYM on $TOR_CONTROL_SOCKET"
		return 1
	fi
	return 0
}

# ---------------------------------------------------------------------------
# DNS
# ---------------------------------------------------------------------------
dns_backend() {
	if command -v systemctl >/dev/null 2>&1 && systemctl is-active --quiet systemd-resolved; then
		echo "resolved"
	elif dpkg-query -W -f='${Status}' resolvconf 2>/dev/null | grep -q 'install ok installed'; then
		echo "resolvconf"
	else
		echo "file"
	fi
}

dns_start() {
	case "$(dns_backend)" in
	resolved)
		# /etc/resolv.conf is a symlink into /run on these hosts, so it is not
		# touched at all; systemd-resolved forwards to Tor's DNSPort instead.
		mkdir -p "$(dirname "$RESOLVED_DROPIN")"
		cat > "$RESOLVED_DROPIN" <<EOF
# Managed by anonsurf: send every query to Tor's DNSPort.
# 'anonsurf stop' removes this file.
[Resolve]
DNS=127.0.0.1
Domains=~.
DNSSEC=no
EOF
		systemctl try-restart systemd-resolved >/dev/null 2>&1
		command -v resolvectl >/dev/null 2>&1 && resolvectl flush-caches >/dev/null 2>&1
		info "DNS delegated to systemd-resolved via $RESOLVED_DROPIN"
		;;
	resolvconf)
		if [ ! -e "$RESOLVCONF_HEAD_BAK" ]; then
			cp -a "$RESOLVCONF_HEAD" "$RESOLVCONF_HEAD_BAK" 2>/dev/null || : > "$RESOLVCONF_HEAD_BAK"
		fi
		printf 'nameserver 127.0.0.1\n' > "$RESOLVCONF_HEAD"
		resolvconf -u >/dev/null 2>&1
		info "DNS delegated to resolvconf at $RESOLVCONF_HEAD"
		;;
	file)
		if [ -L "$RESOLV_CONF" ]; then
			error "$RESOLV_CONF is a symlink managed by another resolver."
			error "Configure that resolver to use 127.0.0.1, or install systemd-resolved/resolvconf support."
			return 1
		fi
		if [ ! -e "$RESOLV_CONF_BAK" ]; then
			cp -a "$RESOLV_CONF" "$RESOLV_CONF_BAK" 2>/dev/null || : > "$RESOLV_CONF_BAK"
		fi
		printf 'nameserver 127.0.0.1\n' > "$RESOLV_CONF"
		info "DNS set to Tor's DNSPort in $RESOLV_CONF"
		;;
	esac
	return 0
}

dns_stop() {
	case "$(dns_backend)" in
	resolved)
		if [ -e "$RESOLVED_DROPIN" ]; then
			rm -f "$RESOLVED_DROPIN"
			systemctl try-restart systemd-resolved >/dev/null 2>&1
			command -v resolvectl >/dev/null 2>&1 && resolvectl flush-caches >/dev/null 2>&1
			info "Removed $RESOLVED_DROPIN"
		fi
		;;
	resolvconf)
		if [ -e "$RESOLVCONF_HEAD_BAK" ]; then
			cp -a "$RESOLVCONF_HEAD_BAK" "$RESOLVCONF_HEAD"
			rm -f "$RESOLVCONF_HEAD_BAK"
			resolvconf -u >/dev/null 2>&1
			info "Restored $RESOLVCONF_HEAD"
		fi
		;;
	file)
		if [ -e "$RESOLV_CONF_BAK" ]; then
			cp -a "$RESOLV_CONF_BAK" "$RESOLV_CONF"
			rm -f "$RESOLV_CONF_BAK"
			info "Restored $RESOLV_CONF"
		fi
		;;
	esac
	return 0
}

# ---------------------------------------------------------------------------
# IPv6
# ---------------------------------------------------------------------------
disable_ipv6() {
	step "Disabling IPv6"
	cat > "$SYSCTL_CONF" <<EOF
# Disable IPv6 - Added by kali-anonsurf
net.ipv6.conf.all.disable_ipv6 = 1
net.ipv6.conf.default.disable_ipv6 = 1
net.ipv6.conf.lo.disable_ipv6 = 1
EOF
	if ! sysctl -p "$SYSCTL_CONF" >/dev/null 2>&1; then
		error "Failed to apply $SYSCTL_CONF"
		return 1
	fi
	if [ -e /proc/sys/net/ipv6/conf/all/disable_ipv6 ] &&
		[ "$(cat /proc/sys/net/ipv6/conf/all/disable_ipv6)" != "1" ]; then
		error "IPv6 is still enabled after applying $SYSCTL_CONF"
		return 1
	fi
	info "IPv6 disabled"
	return 0
}

enable_ipv6() {
	step "Re-enabling IPv6"
	if [ -e "$SYSCTL_CONF" ]; then
		rm -f "$SYSCTL_CONF"
		info "Removed $SYSCTL_CONF"
	fi
	sysctl --system >/dev/null 2>&1
	if [ -e /proc/sys/net/ipv6/conf/all/disable_ipv6 ] &&
		[ "$(cat /proc/sys/net/ipv6/conf/all/disable_ipv6)" != "0" ]; then
		warn "IPv6 is still disabled; another sysctl file sets net.ipv6.conf.all.disable_ipv6"
	fi
	if command -v systemctl >/dev/null 2>&1 && systemctl is-active --quiet NetworkManager; then
		systemctl reload NetworkManager >/dev/null 2>&1
	fi
	return 0
}

# ---------------------------------------------------------------------------
# firewall
# ---------------------------------------------------------------------------
require_iptables() {
	if ! command -v iptables >/dev/null 2>&1; then
		error "iptables is not installed"
		return 1
	fi
	return 0
}

# Create (or reset) the chain and hook it into the built-in one exactly once.
chain_prepare() {
	local table="$1" chain="$2"
	iptables -t "$table" -N "$chain" 2>/dev/null || iptables -t "$table" -F "$chain" || return 1
	if ! iptables -t "$table" -C OUTPUT -j "$chain" 2>/dev/null; then
		iptables -t "$table" -I OUTPUT 1 -j "$chain" || return 1
	fi
}

chain_destroy() {
	local table="$1" chain="$2"
	iptables -t "$table" -D OUTPUT -j "$chain" 2>/dev/null
	iptables -t "$table" -F "$chain" 2>/dev/null
	iptables -t "$table" -X "$chain" 2>/dev/null
	return 0
}

firewall_start() {
	local net

	# nat: everything that leaves the host as TCP is redirected into Tor's
	# TransPort. UDP is deliberately left alone: Tor cannot carry it, so the
	# OUTPUT chain below rejects it instead of pretending to anonymise it.
	chain_prepare nat "$NAT_CHAIN" || return 1
	iptables -t nat -A "$NAT_CHAIN" -m owner --uid-owner "$TOR_UID" -j RETURN
	# DHCP client traffic has to stay on the wire or the host loses its lease.
	iptables -t nat -A "$NAT_CHAIN" -p udp --dport 67 -j RETURN
	iptables -t nat -A "$NAT_CHAIN" -p udp --sport 68 -j RETURN
	iptables -t nat -A "$NAT_CHAIN" -p udp -d "$LIMITED_BROADCAST" -j RETURN
	# DNS. Tor's DNSPort only speaks UDP; DNS over TCP falls through to the
	# generic redirect below and reaches the original resolver through Tor.
	iptables -t nat -A "$NAT_CHAIN" -p udp --dport "$TOR_DNS_PORT" -j REDIRECT --to-ports "$TOR_DNS_PORT"
	# .onion addresses. Must come before the 10.0.0.0/8 exclusion below.
	iptables -t nat -A "$NAT_CHAIN" -p tcp -d "$VIRTUAL_ADDR_NET" -j REDIRECT --to-ports "$TOR_TRANS_PORT"
	# Local destinations are left untouched.
	for net in $TOR_EXCLUDE "$LOOPBACK" "$MULTICAST" "$LIMITED_BROADCAST"; do
		iptables -t nat -A "$NAT_CHAIN" -d "$net" -j RETURN
	done
	iptables -t nat -A "$NAT_CHAIN" -p tcp -j REDIRECT --to-ports "$TOR_TRANS_PORT"

	# filter: only Tor and local destinations may speak to the outside world.
	chain_prepare filter "$OUT_CHAIN" || return 1
	iptables -A "$OUT_CHAIN" -m conntrack --ctstate ESTABLISHED,RELATED -j ACCEPT
	for net in $TOR_EXCLUDE "$LOOPBACK" "$MULTICAST" "$LIMITED_BROADCAST"; do
		iptables -A "$OUT_CHAIN" -d "$net" -j ACCEPT
	done
	iptables -A "$OUT_CHAIN" -m owner --uid-owner "$TOR_UID" -j ACCEPT
	iptables -A "$OUT_CHAIN" -j REJECT --reject-with icmp-port-unreachable

	if ! firewall_verify; then
		error "The firewall rules were not installed completely; rolling back"
		firewall_stop
		return 1
	fi

	info "Traffic is redirected through Tor by the $NAT_CHAIN chain"
	return 0
}

# A partially installed rule set is worse than none: the final REJECT alone
# would cut the host off without even letting Tor out. Check both ends of
# every chain after installing it.
firewall_verify() {
	local first_nat last_nat first_out last_out rc=0

	first_nat=$(iptables -t nat -S "$NAT_CHAIN" 2>/dev/null | grep '^-A' | head -1)
	last_nat=$(iptables -t nat -S "$NAT_CHAIN" 2>/dev/null | grep '^-A' | tail -1)
	first_out=$(iptables -S "$OUT_CHAIN" 2>/dev/null | grep '^-A' | head -1)
	last_out=$(iptables -S "$OUT_CHAIN" 2>/dev/null | grep '^-A' | tail -1)

	case "$first_nat" in
	*"--uid-owner $TOR_UID"*) ;;
	*)
		error "$NAT_CHAIN is missing its Tor bypass rule"
		rc=1
		;;
	esac
	case "$last_nat" in
	*"--to-ports $TOR_TRANS_PORT"*) ;;
	*)
		error "$NAT_CHAIN is missing its final redirect rule"
		rc=1
		;;
	esac
	case "$first_out" in
	*"--ctstate"*) ;;
	*)
		error "$OUT_CHAIN is missing its conntrack rule"
		rc=1
		;;
	esac
	case "$last_out" in
	*"REJECT"*) ;;
	*)
		error "$OUT_CHAIN is missing its final reject rule"
		rc=1
		;;
	esac
	return "$rc"
}

firewall_stop() {
	chain_destroy nat "$NAT_CHAIN"
	chain_destroy filter "$OUT_CHAIN"
	info "Removed the $NAT_CHAIN and $OUT_CHAIN chains"
	return 0
}

# Connections opened before 'start' keep their conntrack entry, bypass the new
# nat rules and keep using the real source address. Killing them is the point.
conntrack_flush() {
	if [ "$ANONSURF_FLUSH_CONNTRACK" != "1" ]; then
		warn "ANONSURF_FLUSH_CONNTRACK=0: connections opened before start still bypass Tor"
		return 0
	fi
	if command -v conntrack >/dev/null 2>&1; then
		conntrack -F >/dev/null 2>&1
		info "Flushed conntrack; existing connections were terminated"
	else
		warn "conntrack-tools is not installed: connections opened before start may keep bypassing Tor"
		warn "install conntrack-tools, or close them manually"
	fi
	return 0
}

# ---------------------------------------------------------------------------
# local state hygiene
# ---------------------------------------------------------------------------
init() {
	if [ "$ANONSURF_KILL_APPS" = "1" ]; then
		info "Killing dangerous applications"
		local app
		for app in $DANGEROUS_APPS; do
			pkill -x "$app" 2>/dev/null
		done
	else
		info "ANONSURF_KILL_APPS=0: leaving applications running"
	fi
	if command -v bleachbit >/dev/null 2>&1; then
		info "Cleaning some dangerous cache elements"
		bleachbit -c adobe_reader.cache chromium.cache chromium.current_session \
			chromium.history elinks.history emesene.cache epiphany.cache \
			firefox.url_history flash.cache flash.cookies google_chrome.cache \
			google_chrome.history links2.history opera.cache opera.search_history \
			opera.url_history >/dev/null 2>&1
	else
		info "bleachbit is not installed, skipping cache cleaning"
	fi
	return 0
}

# ---------------------------------------------------------------------------
# commands
# ---------------------------------------------------------------------------
start() {
	require_root
	require_iptables || exit 1
	require_tor_uid || exit 1
	init
	step "Starting anonymous mode"
	disable_ipv6 || exit 1
	tor_start || exit 1
	dns_start || exit 1
	firewall_start || {
		error "Failed to install the firewall rules"
		dns_stop
		exit 1
	}
	conntrack_flush
	echo -e "$GREEN[$BLUE i$GREEN ]$BLUE You are under AnonSurf tunnel$RESETCOLOR\n"
}

stop() {
	require_root
	require_iptables || exit 1
	init
	step "Stopping anonymous mode"
	firewall_stop
	dns_stop
	tor_stop
	enable_ipv6
	echo -e " $GREEN*$BLUE Anonymous mode stopped$RESETCOLOR\n"
}

change() {
	require_root
	if tor_newnym; then
		echo -e " $GREEN*$BLUE Tor was asked for new circuits (NEWNYM)$RESETCOLOR\n"
	fi
}

status() {
	local backend
	step "Tor"
	systemctl --no-pager --lines=0 status "$TOR_UNIT" 2>/dev/null ||
		echo " $RED*$BLUE $TOR_UNIT is not active$RESETCOLOR"
	echo
	step "Firewall"
	if iptables -t nat -S "$NAT_CHAIN" >/dev/null 2>&1; then
		iptables -t nat -S "$NAT_CHAIN"
	else
		echo " $RED*$BLUE nat chain $NAT_CHAIN is absent"
	fi
	if iptables -S "$OUT_CHAIN" >/dev/null 2>&1; then
		iptables -S "$OUT_CHAIN"
	else
		echo " $RED*$BLUE filter chain $OUT_CHAIN is absent"
	fi
	echo
	backend=$(dns_backend)
	step "DNS backend: $backend"
	echo
}

ip_cmd() {
	step "Egress address (opening this leaks nothing to the destination site, but the request itself is not anonymous)"
	local out
	out=$(curl -fsS --max-time 15 https://check.torproject.org/api/ip 2>/dev/null) ||
		out=$(curl -fsS --max-time 15 https://api.ipify.org 2>/dev/null) ||
		{
			error "Could not determine the egress address"
			return 1
		}
	echo "$out"
	case "$out" in
	*'"IsTor":false'*) error "Traffic is NOT going through Tor" ;;
	esac
	echo
}

starti2p() {
	require_root
	if ! command -v i2prouter >/dev/null 2>&1; then
		error "i2p is not installed; run 'apt-get install i2p'"
		return 1
	fi
	step "Starting I2P services"
	firewall_stop
	dns_stop
	tor_stop
	sudo -u i2psvc i2prouter start
	sleep 2
	command -v xdg-open >/dev/null 2>&1 && xdg-open 'http://127.0.0.1:7657/home' >/dev/null 2>&1
}

stopi2p() {
	require_root
	if ! command -v i2prouter >/dev/null 2>&1; then
		error "i2p is not installed"
		return 1
	fi
	step "Stopping I2P services"
	sudo -u i2psvc i2prouter stop
}

usage() {
	echo -e "
Parrot AnonSurf Module
	Usage:
	$RED┌──[$GREEN$USER$YELLOW@$BLUE`hostname`$RED]─[$GREEN$PWD$RED]
	$RED└──╼ \$$GREEN"" anonsurf $RED{$GREEN""start$RED|$GREEN""stop$RED|$GREEN""restart$RED|$GREEN""change$RED""$RED|$GREEN""status$RED""}

	$RED start$BLUE -$GREEN Start system-wide anonymous
		  tunneling under TOR proxy through iptables
	$RED stop$BLUE -$GREEN Reset original iptables settings
		  and return to clear navigation
	$RED restart$BLUE -$GREEN Combines \"stop\" and \"start\" options
	$RED change$BLUE -$GREEN Changes identity asking Tor for new circuits
	$RED status$BLUE -$GREEN Check if AnonSurf is working properly
	$RED myip$BLUE -$GREEN Show your current IP address $RED(RISKY)$RESETCOLOR
	----[ I2P related features ]----
	$RED starti2p$BLUE -$GREEN Start i2p services
	$RED stopi2p$BLUE -$GREEN Stop i2p services

	Override defaults in /etc/default/anonsurf (TOR_UID, TOR_EXCLUDE,
	ANONSURF_KILL_APPS, ANONSURF_FLUSH_CONNTRACK).
$RESETCOLOR" >&2
	return 1
}

# Allow the functions above to be sourced by tests.
if [ "${BASH_SOURCE[0]}" = "$0" ]; then
	case "$1" in
		start)
			start
			;;
		stop)
			stop
			;;
		change)
			change
			;;
		status)
			status
			;;
		myip|ip)
			ip_cmd
			;;
		starti2p)
			starti2p
			;;
		stopi2p)
			stopi2p
			;;
		restart)
			"$0" stop
			sleep 1
			"$0" start
			;;
		*)
			usage
			exit 1
			;;
	esac
	echo -e "$RESETCOLOR"
	exit 0
fi
