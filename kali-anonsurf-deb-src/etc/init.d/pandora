#!/bin/bash
### BEGIN INIT INFO
# Provides:          pandora-bootparam
# Required-Start:
# Required-Stop:        umountroot
# Should-Start:
# Should-Stop:          halt reboot
# Default-Start:        2 3 4 5
# Default-Stop:         0 1 6
# Short-Description: Open Parrot Pandora's box and clean the RAM.
### END INIT INFO

#
# Lorenzo "EclipseSpark" Faletra <eclipse@frozenbox.org>
#         Parrot Security OS www.parrotsec.org
#                      GNU/GPL v3
#

GREEN='\033[1;92m'
BLUE='\033[1;94m'
RED='\033[1;91m'
RESETCOLOR='\033[1;00m'

sysctl_write() {
	# Kernel tunables are best effort: some are read only in containers and
	# on hardened kernels, and a failure there must not abort the RAM wipe.
	echo "$2" > "/proc/sys/vm/$1" 2>/dev/null
	return 0
}

function bomb {
	echo "starting Parrot Pandora's box "
	sleep 5
	echo "Pandora is dropping caches"
	sysctl_write min_free_kbytes 1024
	sysctl_write drop_caches 3
	sysctl_write oom_kill_allocating_task 1
	sysctl_write overcommit_memory 1
	sysctl_write oom_dump_tasks 0
	echo "Pandora is bombing RAM"
	if command -v sdmem >/dev/null 2>&1; then
		sdmem -fllv
		echo " - RAM bombed"
	else
		echo -e "$RED secure-delete is not installed, skipping the RAM wipe$RESETCOLOR"
	fi
	echo "closing Parrot Pandora's box"
}

case "$1" in
	start)
		echo "Argument '$1' is not supported, use bomb instead"
		;;
	restart|reload|force-reload)
		echo "Error: argument '$1' is not supported, use bomb instead"
		;;
	stop|bomb)
		bomb
		;;
	*)
		echo "USAGE: pandora bomb"
		;;
esac

exit 0
